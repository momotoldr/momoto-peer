# Port the broker listens on. Render injects PORT — read it from the environment.
PORT=9000

# Mount path for the broker. Must match the frontend's VITE_PEERJS_PATH.
PEER_PATH=/

# Key a client must present. The PeerJS client defaults to "peerjs"; only change this
# if the frontend passes a matching `key` option.
PEER_KEY=peerjs

# Comma-separated allowlist of frontend origins, for CORS and for the broker WebSocket.
# Example: https://app.example.com
CORS_ORIGINS=http://localhost:5173

# Header holding the visitor's address behind the proxy. Default cf-connecting-ip.
# CLIENT_IP_HEADER=cf-connecting-ip

# Most peers connected at once; past it every new call fails. Default 20000.
# PEER_CONCURRENT_LIMIT=20000

# Most sockets one address may hold. Generous because a campus or a mobile carrier can
# share one address. Default 200.
# PEER_MAX_PER_ADDRESS=200
